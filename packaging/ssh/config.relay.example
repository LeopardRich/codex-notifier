Host codex-notifier-desktop
    HostName DESKTOP_HOST_OR_VPN_ADDRESS
    Port 22
    User DESKTOP_USER
    IdentityFile ~/.ssh/codex-notifier-desktop
    IdentitiesOnly yes
    BatchMode yes
    NumberOfPasswordPrompts 0
    ConnectionAttempts 1
    StrictHostKeyChecking yes
    UserKnownHostsFile ~/.ssh/known_hosts
    RequestTTY no
    ForwardAgent no
    ClearAllForwardings yes
